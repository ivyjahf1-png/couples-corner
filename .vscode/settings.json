{
  // Tailwind v4 uses custom at-rules (@theme, @utility, @variant, @custom-variant)
  // that the built-in CSS language server doesn't recognize. Silence that class
  // of false positives; real CSS errors still surface through the build/lint.
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore"
}
