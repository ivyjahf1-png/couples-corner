rules_version = '2';

// =============================================================================
// Couples Corner — Cloud Storage Security Rules
//
// Uploads are authenticated, MIME-restricted, size-capped, and immutable.
// Message media is NEVER publicly readable. Clients may not list directories
// (no enumeration).
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function underMB(n) {
      return request.resource.size < n * 1024 * 1024;
    }

    // Avatars: public read by design (profile identity), owner-only writes.
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid
        && isImage() && underMB(5);
    }

    // Profile photos (userProfiles.photos): public read, owner-only writes.
    // Enforced here and again in the Admin SDK server path so a user can never
    // overwrite another user's profile media.
    match /profiles/{uid}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid
        && isImage() && underMB(5);
    }

    // Couple media: writes restricted to (server-managed) couple members.
    match /couples/{coupleId}/{fileName} {
      allow read: if true; // couple profile imagery is public-facing
      allow write: if signedIn()
        && firestore.exists(/databases/(default)/documents/coupleMembers/$(coupleId + '_' + request.auth.uid))
        && isImage() && underMB(8);
    }

    // Post media: write by post author; read mirrors post visibility.
    match /posts/{postId}/{fileName} {
      allow read: if signedIn()
        && firestore.get(/databases/(default)/documents/posts/$(postId)).data.authorId == request.auth.uid;
      allow write: if signedIn()
        && firestore.get(/databases/(default)/documents/posts/$(postId)).data.authorId == request.auth.uid
        && isImage() && underMB(10);
    }

    // Message attachments: strictly participant-only, never public.
    match /messages/{conversationId}/{fileName} {
      allow read, write: if signedIn()
        && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants
        && isImage() && underMB(8);
    }

    // Content media (ads, featured images/videos): public read, admin write only.
    // Files live at content/{contentId}/{fileName}. Writes happen via the Admin
    // SDK in Server Actions; client writes (and directory listing) denied.
    match /content/{contentId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else: denied (includes listing any directory).
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
