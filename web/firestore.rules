rules_version = '2';

/**
 * Couples Corner — Cloud Firestore Security Rules.
 *
 * SECURITY MODEL
 * - Firestore rules are the PRIMARY enforcement layer; app code re-checks for
 *   UX only. Never rely on client code for authorization.
 * - Admin authority comes ONLY from the Auth custom claim `request.auth.token.admin`,
 *   set exclusively via the Admin SDK. No Firestore field can grant admin.
 * - `users`, `notifications`, and `auditLogs` are server-managed: clients cannot
 *   create or modify them directly.
 * - Blocking (`blocks`) is consulted by every content rule, bidirectionally.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- Helpers ---------- */

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Canonical, order-independent block doc id.
    function blockId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function isBlockedBetween(a, b) {
      return exists(/databases/$(database)/documents/blocks/$(blockId(a, b)));
    }

    /* ---------- users (server-managed identity & role) ---------- */
    match /users/{uid} {
      // Role/status live here but are NEVER client-writable. Profile creation
      // happens in a Server Action via the Admin SDK after email verification.
      allow get, list: if signedIn();
      allow create, update, delete: if false;
    }

    /* ---------- usernames (uniqueness reservations) ---------- */
    match /usernames/{username} {
      allow read: if true;
      // Reserved by server after validation; immutable once claimed.
      allow write: if false;
    }

    /* ---------- userProfiles (editable profile data) ---------- */
    match /profiles/{uid} {
      allow get: if signedIn() && (
        isUser(uid) ||
        isAdmin() ||
        (
          resource.data.visibility == 'public' &&
          !isBlockedBetween(uid, request.auth.uid)
        )
      );
      allow list: if false; // discovery reads go through server-side queries
      allow create, update: if isUser(uid)
        && request.resource.data.uid == uid
        // owner may edit presentation + privacy fields only; identity fields
        // (uid, createdAt) cannot be tampered with. Edit keys mirror the
        // ProfileUpdateInput shape in lib/server/profiles.ts.
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'bio', 'avatarUrl', 'photos', 'interests',
                       'location', 'gender', 'orientation', 'dateOfBirth',
                       'relationshipStatus', 'profileType', 'visibility',
                       'discoverable', 'updatedAt']);
      allow delete: if false;
    }

    /* ---------- couple profiles & membership ---------- */
    match /coupleProfiles/{coupleId} {
      function isMember() {
        return signedIn() &&
          exists(/databases/$(database)/documents/coupleMembers/$(coupleId + '_' + request.auth.uid));
      }
      allow get: if signedIn() && (
        isAdmin() ||
        (!resource.data.isPrivate && !isBlockedBetween(resource.data.memberIds[0], request.auth.uid)) ||
        isMember()
      );
      allow list: if false;
      allow create, update, delete: if isAdmin() || false; // managed via Server Actions
    }

    match /coupleMembers/{memberId} {
      allow read: if signedIn() &&
        (request.auth.uid in memberId.split('_') || isAdmin());
      allow write: if false; // Server Actions only (max 2 members enforced there)
    }

    /* ---------- connections & requests ---------- */
    match /connectionRequests/{requestId} {
      allow read: if signedIn() &&
        (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      // Creation and status transitions run through Server Actions so block
      // checks and single-pending-request invariants are enforced server-side.
      allow write: if false;
    }

    match /connections/{connectionId} {
      allow read: if signedIn() &&
        (resource.data.userAId == request.auth.uid || resource.data.userBId == request.auth.uid);
      allow write: if false; // created by Server Action on request acceptance
    }

    /* ---------- conversations & messages (participants only) ---------- */
    match /conversations/{conversationId} {
      function isParticipant() {
        return signedIn() && request.auth.uid in resource.data.participants;
      }

      allow get: if isAdmin() || isParticipant();
      allow list: if false; // participants query their list via Server Components
      allow create, update, delete: if false; // created by Server Action with block checks

      match /messages/{messageId} {
        function conversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        // Only participants can read; messages are immutable after creation.
        allow get, list: if isAdmin() || (signedIn() && request.auth.uid in conversation().participants);
        // Sender must be a participant; block check against the other participant.
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in conversation().participants
          && !isBlockedBetween(request.auth.uid,
               conversation().participants[0] == request.auth.uid
                 ? conversation().participants[1]
                 : conversation().participants[0]);
        allow update, delete: if false;
      }
    }

    /* ---------- posts, media, likes, comments ---------- */
    match /posts/{postId} {
      function postVisible() {
        return signedIn() && (
          isAdmin() ||
          resource.data.authorId == request.auth.uid ||
          (resource.data.visibility == 'public' &&
           !isBlockedBetween(resource.data.authorId, request.auth.uid))
        );
      }

      allow get: if postVisible();
      allow list: if false;
      // Author writes go through Server Actions for validation & moderation;
      // direct client writes are disabled to keep invariants in one place.
      allow create, update, delete: if false;

      match /postMedia/{mediaId} {
        allow read: if postVisible();
        allow write: if false;
      }

      match /likes/{likerId} {
        allow read: if postVisible();
        // Doc id = uid: a user can only toggle their own like.
        allow create, delete: if isUser(likerId);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if postVisible();
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid
          && !isBlockedBetween(resource.data.authorId, request.auth.uid);
        allow update, delete: if false; // edits/removals via Server Action (author or admin)
      }
    }

    /* ---------- notifications (server-written, recipient-readable) ---------- */
    match /notifications/{notificationId} {
      allow get, list: if signedIn() && resource.data.recipientId == request.auth.uid;
      // Fan-out happens via Admin SDK / Cloud Functions — prevents spoofed
      // notifications like "someone liked your post".
      allow create, update, delete: if false;
    }

    /* ---------- blocks (blocker-managed, bidirectionally enforced) ---------- */
    match /blocks/{pairId} {
      // Doc id is blockerId_blockedId (canonical order), so ownership is
      // encoded in the id and cannot be forged.
      allow read: if signedIn() &&
        (pairId.split('_')[0] == request.auth.uid || pairId.split('_')[1] == request.auth.uid);
      allow create, delete: if signedIn() && pairId.split('_')[0] == request.auth.uid;
      allow update: if false;
    }

    /* ---------- reports (users file, admins review) ---------- */
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false; // handled server-side with audit logging
    }

    /* ---------- audit logs (admin-readable, server-written) ---------- */
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // written by Admin SDK in the same transaction as the action
    }

    /* ---------- content (admin-managed, public read of published) ---------- */
    match /content/{contentId} {
      // Only published, in-window content is readable by the public (used for
      // display slots). Draft/scheduled/archived content is admin-only, so it
      // can never leak by id.
      function contentVisible() {
        return isAdmin() || (
          resource.data.status == 'published' &&
          resource.data.startAt <= request.time &&
          resource.data.endAt >= request.time
        );
      }
      allow get: if contentVisible();
      allow list: if isAdmin() || contentVisible();
      // ALL client writes denied — content is managed via Server Actions (Admin SDK).
      allow create, update, delete: if false;
    }

    /* ---------- default deny ---------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
